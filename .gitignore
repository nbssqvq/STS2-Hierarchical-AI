# Python bytecode and local environments
__pycache__/
*.py[cod]
*.pyd
/.venv/
/venv/
/env*/

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.save
*.lnk
*.url

# Game, training, and evaluation artifacts
/.checkpoints/
/.checkpoint/
/checkpoints/
/logs/
/models/
/outputs/
/runs/
*.mappings.json
*.log
*.tmp
*.out.tfevents.*
events.out.tfevents.*
episode.monitor.csv
progress.csv

# C# MCP source at the repository root is a local reverse-engineering reference.
# Only the deployable MCP DLL and manifest are published.
*.cs
!/mods/PunchOffInstantFix/Patch.cs
/mods/McpBuild/*.csproj
/mods/PunchOffInstantFix/Probe.cs
/mods/PunchOffInstantFix/probe-request.txt

# Keep only the release DLLs intended for the game mods directory.
*.dll
*.pdb
/mods/McpBuild/bin/Release/net9.0/*
!/mods/McpBuild/bin/Release/net9.0/STS2_MCP.dll
/mods/PunchOffInstantFix/bin/Release/net9.0/*
!/mods/PunchOffInstantFix/bin/Release/net9.0/PunchOffInstantFix.dll
**/obj/

# Curated, versioned inference artifacts live outside the ignored local models/ tree.
/artifacts/models/**
!/artifacts/models/ppo_800k/
!/artifacts/models/ppo_800k/final_model.zip
!/artifacts/models/ppo_800k/final_model.mappings.json
!/artifacts/models/qwen3_4b_lora/
!/artifacts/models/qwen3_4b_lora/adapter_model.safetensors
!/artifacts/models/qwen3_4b_lora/adapter_config.json
!/artifacts/models/qwen3_4b_lora/tokenizer.json
!/artifacts/models/qwen3_4b_lora/tokenizer_config.json
!/artifacts/models/qwen3_4b_lora/chat_template.jinja

# Game decompilation and inspection output
/tools/inspect_game/
*.il.txt

# Project-local instructions and GitHub settings excluded by request
/.github/
/AGENTS.md
/agents.md

# IDE and OS files
.idea/
.vs/
.vscode/
Thumbs.db
Desktop.ini
